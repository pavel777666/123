async def check_sub(cb: CallbackQuery):
    if await is_subscribed(cb.from_user.id):
        upsert_user(cb.from_user, 1)
        await cb.message.edit_text("✅ Подписка подтверждена! Кидай ссылку на видео.")
        await cb.answer()
    else:
        await cb.answer("Подписка не найдена. Подпишись и нажми кнопку снова.", show_alert=True)

