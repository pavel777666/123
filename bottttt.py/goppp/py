#---------------- Состояния ----------------
user_mode: dict[int, str | None] = {}   # None = авто 720p, "choose" = выбор качества
pending: dict[int, tuple[str, float]] = {}   # user_id -> (url, время)
last_links: dict[int, str] = {}         # для /again
rate: dict[int, list[float]] = {}       # антиспам

def platform_of(url: str) -> str:
    if "tiktok" in url: return "TikTok"
    if "instagram" in url: return "Instagram"
    return "YouTube"

def rate_ok(user_id: int) -> bool:
    now = time.time()
    window = [t for t in rate.get(user_id, []) if now - t < 60]
    if len(window) >= RATE_LIMIT:
        rate[user_id] = window
        return False
    window.append(now)
    rate[user_id] = window
    return True





#---------------- Скачивание ----------------
def build_opts(quality: int, progress_cb=None) -> dict:
    opts = {
        "format": (
            f"bestvideo[height<={quality}][ext=mp4]+bestaudio[ext=m4a]"
            f"/best[height<={quality}][ext=mp4]/best[height<={quality}]/best"
        ),
        "outtmpl": os.path.join(DOWNLOAD_DIR, "%(id)s.%(ext)s"),
        "merge_output_format": "mp4",
        "noplaylist": True,
        "quiet": True,
        "no_warnings": True,
        "retries": 3,
        "socket_timeout": 30,
        "concurrent_fragment_downloads": 8,   # скорость: параллельная загрузка
        "http_chunk_size": 10485760,
    }

    if os.path.exists(COOKIE_FILE):
        opts["cookiefile"] = COOKIE_FILE
    if progress_cb:
        def hook(d):
            if d["status"] == "downloading":
                total = d.get("total_bytes") or d.get("total_bytes_estimate") or 1
                progress_cb(int((d.get("downloaded_bytes") or 0) / total * 100))
        opts["progress_hooks"] = [hook]
    return opts

def download_sync(url: str, quality: int, progress_cb=None) -> str:
    with yt_dlp.YoutubeDL(build_opts(quality, progress_cb)) as ydl:
        info = ydl.extract_info(url, download=True)
        if "entries" in info:
            info = info["entries"][0]
        return info["requested_downloads"][0]["filepath"]

async def process(message: Message, url: str, quality: int):
    user_id = message.from_user.id
    platform = platform_of(url)

    if not rate_ok(user_id):
        await message.answer(f"Слишком много запросов — максимум {RATE_LIMIT} в минуту 🙂")
        return

    status = await message.answer("⏳ Скачиваю… 0%")
    last_pct = {"v": -1}

    def progress(pct):
        if pct >= last_pct["v"] + 20:
            last_pct["v"] = pct
            try:
                asyncio.run_coroutine_threadsafe(
                    status.edit_text(f"⏳ Скачиваю… {pct}%"), loop
                )
            except Exception:
                pass

    loop = asyncio.get_running_loop()
    path = None
    try:
        path = await loop.run_in_executor(executor, download_sync, url, quality, progress)
        size_mb = os.path.getsize(path) / 1048576

        if size_mb > MAX_FILE_MB:
            await status.edit_text(
                f"Файл весит {size_mb:.0f} МБ — больше лимита Telegram (50 МБ). "
                "Попробуй качество пониже."
            )
            log_action(user_id, platform, str(quality), size_mb, "too_big")
        else:
            await status.edit_text("📤 Отправляю…")
            await message.answer_video(
                FSInputFile(path),
                caption=f"{platform} · {quality}p · {size_mb:.1f} МБ",
            )
            last_links[user_id] = url
            log_action(user_id, platform, str(quality), size_mb, "ok")
            await status.delete()
    except yt_dlp.utils.DownloadError as e:
        msg = str(e)
        if "Sign in" in msg or "LOGIN_REQUIRED" in msg:
            await status.edit_text("YouTube требует авторизацию — обновите cookies.txt.")
        elif "login" in msg.lower() or "401" in msg:
            await status.edit_text("Instagram требует свежие cookies — обновите cookies.txt.")
        else:
            await status.edit_text(f"Не удалось скачать 😕\n{msg[:200]}")
        log_action(user_id, platform, str(quality), 0, "fail")
    except Exception as e:
        await status.edit_text(f"Ошибка: {e}")
        log_action(user_id, platform, str(quality), 0, "fail")
    finally:
        if path and os.path.exists(path):
            os.remove(path)





