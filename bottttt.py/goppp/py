        upsert_user(message.from_user, 1)
        await message.answer(
            "Привет! Кидай ссылку на видео с YouTube, TikTok или Instagram — "
            f"скачаю автоматически в {DEFAULT_QUALITY}p.\n\n"
            "Команды:\n"
            "/quality — выбор качества для следующего видео\n"
            "/auto — вернуть автокачание в 720p\n"
            "/again — перекачать последнее видео\n"
            "/help — вся справка"
        )
    else:
        upsert_user(message.from_user, 0)
        await message.answer(
            "Чтобы качать видео, подпишись на канал и нажми кнопку проверки 👇",
            reply_markup=sub_keyboard(),
        )

