@dp.message(Command("again"))
async def again_cmd(message: Message):
    url = last_links.get(message.from_user.id)
    if not url:
        await message.answer("Ты пока не качал ни одного видео.")
        return
    if not await is_subscribed(message.from_user.id):
        await message.answer("Сначала подпишись на канал 👇", reply_markup=sub_keyboard())
        return
    await process(message, url, DEFAULT_QUALITY)

@dp.message(Command("stats"))
async def stats_cmd(message: Message):
    if message.from_user.id not in ADMIN_IDS:
        await message.answer("Команда только для админа.")
        return
    with db() as c:
        total, subs = c.execute(
            "SELECT COUNT(), COALESCE(SUM(subscribed),0) FROM users"
        ).fetchone()
        dl, ok = c.execute(
            "SELECT COUNT(), COALESCE(SUM(status='ok'),0) FROM logs"
        ).fetchone()
        top = c.execute(
            "SELECT platform, COUNT(*) FROM logs GROUP BY platform ORDER BY 2 DESC"
        ).fetchall()
    lines = [
        f"👤 Пользователей: {total} (подписаны: {subs})",
        f"⬇️ Скачиваний: {dl} (успешных: {ok})",
    ]
    lines += [f"  {p}: {n}" for p, n in top]
    await message.answer("\n".join(lines))

@dp.message(F.text.regexp(URL_RE))
async def on_link(message: Message):
    user_id = message.from_user.id
    if not await is_subscribed(user_id):
        upsert_user(message.from_user, 0)
        await message.answer("Сначала подпишись на канал 👇", reply_markup=sub_keyboard())
        return

    upsert_user(message.from_user, 1)
    url = URL_RE.search(message.text).group(0)

    if user_mode.get(user_id) == "choose":
        pending[user_id] = (url, time.time())
        await message.answer("Выбери качество:", reply_markup=quality_kb)
    else:
        await process(message, url, DEFAULT_QUALITY)  # авто-режим: сразу 720p

@dp.callback_query(F.data.startswith("q:"))
async def pick_quality(cb: CallbackQuery):
    quality = int(cb.data.split(":")[1])
    entry = pending.pop(cb.from_user.id, None)
    if not entry:
        await cb.answer("Сначала пришли ссылку 🙂", show_alert=True)
        return
    url, ts = entry
    if time.time() - ts > LINK_TTL:
        await cb.answer("Слишком долго выбирал — пришли ссылку заново.", show_alert=True)
        return
    await cb.answer()
    await process(cb.message, url, quality)

@dp.message()
async def fallback(message: Message):
    await message.answer("Пришли ссылку на видео с YouTube, TikTok или Instagram.")




