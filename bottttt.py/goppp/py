OK_STATUS = {ChatMemberStatus.MEMBER, ChatMemberStatus.ADMINISTRATOR, ChatMemberStatus.CREATOR}

async def is_subscribed(user_id: int) -> bool:
    try:    
        member = await bot.get_chat_member(CHANNEL, user_id)
        return member.status in OK_STATUS
    except Exception:
        return False
    
