#---------------- База данных ----------------
def db() -> sqlite3.Connection:
    conn = sqlite3.connect(DB_PATH)
    conn.execute("""
        CREATE TABLE IF NOT EXISTS users (
            user_id     INTEGER PRIMARY KEY,
            username    TEXT,
            full_name   TEXT,
            subscribed  INTEGER DEFAULT 0,
            downloads   INTEGER DEFAULT 0,
            first_seen  TEXT,
            last_seen   TEXT
         )
    """)
    conn.execute("""
        CREATE TABLE IF NOT EXISTS logs (
            id        INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id   INTEGER,
            platform  TEXT,
            quality   TEXT,
            size_mb   REAL,
            status    TEXT,
            ts        TEXT DEFAULT (datetime('now', 'localtime'))
        )
    """)
    return conn

def upsert_user(user, subscribed: int):
    with db() as c:
        c.execute("""
        INSERT INTO users (user_id, username, full_name, subscribed,
                            first_seen, last_seen)
        VALUES (?, ?, ?, ?, datetime('now','localtime'), datetime('now','localtime'))
        ON CONFLICT(user_id) DO UPDATE SET
            username = excluded.username,
            full_name = excluded.full_name,
            subscribed = excluded.subscribed,
            last_seen = datetime('now','localtime')
    """, (user.id, user.username or "", user.full_name, subscribed))
        
def log_action(user_id: int, platform: str, quality: str, size_mb: float, status: str):
    with db() as c:
        c.execute(
            "INSERT INTO logs (user_id, platform, quality, size_mb, status) VALUES (?,?,?,?,?)",
            (user_id, platform, quality, size_mb, status),
        )
        if status == "ok":
            c.execute("UPDATE users SET downloads = downloads + 1 WHERE user_id = ?", (user_id,))




            
